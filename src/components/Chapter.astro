---
import { render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'kapitoly'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<h1 class="chapter-title" data-tone={entry.data.icon}>
  {
    entry.data.icon && (
      <span class="icon-chip">
        <Icon name={entry.data.icon as 'bolt'} />
      </span>
    )
  }
  {entry.data.title}
</h1>
<slot name="top" />
<div class="prose" data-tone={entry.data.icon}>
  <Content />
</div>
<slot />
<footer class="sources">
  <strong>Zdroje:</strong>
  <ul>
    {entry.data.sources.map((source) => <li>{source.url ? <a href={source.url}>{source.name}</a> : source.name}</li>)}
  </ul>
</footer>
