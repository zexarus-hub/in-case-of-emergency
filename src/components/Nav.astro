---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;

// Každá sekce uvádí všechny cesty, na kterých má být záložka aktivní.
const items = [
  { href: '', label: 'Pomoc', icon: 'alert', paths: ['situace/'] },
  { href: 'navody/', label: 'Návody', icon: 'book', paths: ['navody/'] },
  { href: 'rodinny-plan/', label: 'Plán', icon: 'users', paths: ['rodinny-plan/'] },
  { href: 'pripav-se/', label: 'Příprava', icon: 'clipboard', paths: ['pripav-se/', 'evakuacni-zavazadlo/', 'mapy/'] },
] as const;

const current = Astro.url.pathname;
const isActive = (item: (typeof items)[number]) =>
  (item.href === '' && current === base) || item.paths.some((path) => current.startsWith(`${base}${path}`));
---

<nav class="main-nav" aria-label="Hlavní navigace">
  {
    items.map((item) => (
      <a href={`${base}${item.href}`} aria-current={isActive(item) ? 'page' : undefined}>
        <span class="nav-icon">
          <Icon name={item.icon} />
        </span>
        {item.label}
      </a>
    ))
  }
</nav>
