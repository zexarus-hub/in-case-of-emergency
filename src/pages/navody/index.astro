---
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';

const navody = (await getCollection('kapitoly', ({ id }) => id.startsWith('navody/'))).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<Base title="Návody">
  <h1>Návody</h1>
  <ul class="link-list">
    {
      navody.map((entry) => (
        <li>
          <a class="row-link" data-tone={entry.data.icon} href={`${import.meta.env.BASE_URL}${entry.id}/`}>
            <span class="icon-chip">
              <Icon name={entry.data.icon as 'bolt'} />
            </span>
            <span class="row-text">
              {entry.data.title}
              <small>{entry.data.description}</small>
            </span>
            <Icon name="chevron" class="row-chevron" />
          </a>
        </li>
      ))
    }
  </ul>
</Base>
