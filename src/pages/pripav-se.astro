---
import { getEntry } from 'astro:content';
import BackupPanel from '../components/BackupPanel.svelte';
import Chapter from '../components/Chapter.astro';
import Checklist from '../components/Checklist.svelte';
import Base from '../layouts/Base.astro';

const entry = (await getEntry('kapitoly', 'pripav-se'))!;
const checklist = (await getEntry('checklisty', 'pripav-se'))!;
---

<Base title={entry.data.title}>
  <Chapter entry={entry}>
    <Checklist client:load groups={checklist.data.groups} />
    <BackupPanel client:load />
  </Chapter>
</Base>
