---
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  // Odkaz zpět na nadřazenou stránku. Stránky hlavní navigace ho nemají.
  back?: { href: string; label: string };
}

const { title, back } = Astro.props;
const base = import.meta.env.BASE_URL;
const swUrl = `${base}sw.js`;
const isSearch = Astro.url.pathname.startsWith(`${base}hledat`);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Příručka" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} – Krizová příručka</title>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <!-- Motiv se nastaví ještě před vykreslením, aby tmavý režim nebliknul bíle. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#000000');
        }
      } catch {}
    </script>
    <script is:inline define:vars={{ swUrl }}>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register(swUrl);
    </script>
  </head>
  <body>
    <header class="app-header">
      <a class="home-link" href={base} aria-label="Domů na úvodní obrazovku">
        <svg viewBox="0 0 512 512" aria-hidden="true">
          <rect width="512" height="512" fill="#000" />
          <path d="M256 96 416 400H96z" fill="#ffd400" />
          <path d="M240 192h32v112h-32zM240 328h32v32h-32z" fill="#000" />
        </svg>
      </a>
      {
        back ? (
          <a class="back-link" href={`${base}${back.href}`}>
            <Icon name="back" />
            <span>{back.label}</span>
          </a>
        ) : (
          <a class="search-pill" href={`${base}hledat/`}>
            <Icon name="search" />
            Hledat
          </a>
        )
      }
      <div class="header-actions">
        {
          back && !isSearch && (
            <a class="icon-button" href={`${base}hledat/`} aria-label="Hledat">
              <Icon name="search" />
            </a>
          )
        }
        <button class="icon-button" type="button" data-theme-toggle hidden>
          <Icon name="sun" class="icon-sun" />
          <Icon name="moon" class="icon-moon" />
        </button>
        {
          /* Úvodní obrazovka má vlastní velké tlačítko 155. */
          Astro.url.pathname !== base && (
            <a class="icon-button icon-button-call" href="tel:155" aria-label="Zavolat záchranku 155">
              <Icon name="phone" />
              155
            </a>
          )
        }
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <Nav />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
