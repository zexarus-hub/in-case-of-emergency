---
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  // Odkaz zpět na nadřazenou stránku. Stránky hlavní navigace ho nemají.
  back?: { href: string; label: string };
}

const { title, back } = Astro.props;
const base = import.meta.env.BASE_URL;
const swUrl = `${base}sw.js`;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Příručka" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>{title} – Krizová příručka</title>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <!-- Motiv se nastaví ještě před vykreslením, aby světlý režim nebliknul černě. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#ffffff');
        }
      } catch {}
    </script>
    <script is:inline define:vars={{ swUrl }}>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register(swUrl);
    </script>
  </head>
  <body>
    <header class="app-header">
      {
        back ? (
          <a class="back-link" href={`${base}${back.href}`}>
            <Icon name="back" />
            {back.label}
          </a>
        ) : (
          <span class="app-title">Krizová příručka</span>
        )
      }
      <div class="header-actions">
        <button class="icon-button" type="button" data-theme-toggle hidden>
          <Icon name="sun" class="icon-sun" />
          <Icon name="moon" class="icon-moon" />
        </button>
        {
          /* Úvodní obrazovka má vlastní velké tlačítko 155. */
          Astro.url.pathname !== base && (
            <a class="icon-button icon-button-call" href="tel:155" aria-label="Zavolat záchranku 155">
              <Icon name="phone" />
              155
            </a>
          )
        }
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <Nav />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
